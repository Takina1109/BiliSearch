# 复制为 keystore.properties 后填入自己的信息（该文件已被 .gitignore 忽略，不会上传）
#
# 1. 生成 keystore（在仓库根目录执行，密码自己设定）：
#    keytool -genkeypair -v -keystore bilisearch-release.jks -alias bilisearch \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. 填写下面的字段，然后执行：
#    gradlew.bat assembleRelease
#
# 产物：app/build/outputs/apk/release/app-release.apk

storeFile=bilisearch-release.jks
storePassword=你的密码
keyAlias=bilisearch
keyPassword=你的密码
